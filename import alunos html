  <h1>Importar arquivos CSV</h1>
  <input type="file" id="arquivoCSV" accept=".csv">
  <button onclick="enviarArquivo('csv')">Enviar CSV</button>
  <!--TABELa SE ESCOLHER CSV-->
  <table id="CSVtabela" border="1">
    <tr>
      <td>RA</td>
      <td>Nome Completo</td>
    </tr>
  </table>
  <!--TABELA SE ESCOLHER JSON-->

  <h2>Importar arquivos JSON</h2>
  <input type="file" id="arquivoJSON" accept=".json">
  <button onclick="enviarArquivo('json')">Enviar JSON</button>

  <table id="JSONtabela" border="1">
    <tr>
      <td>Identificador (RA, matrícula, código, id)</td>
      <td>Nome (nome, fullName, completeName, name)</td>
    </tr>
  </table>



{
  "compilerOptions": {
    //opcoes basicas
    "target": "es2020", //modo que ele vai trabalhar, padrão de linguagem
    "module": "commonjs",//geração do js, seguindo um padrão, *modulos* do js
    "rootDir": ".", //onde estará os arquivos typescript
    "outDir": "./dist", //pega tudo e converte para js, e cuspe o arquivo dentro do diretorio dist
    "strict": false, //modo nao strict para evitar erros de tipos
    //opcoes de caminho
    "baseUrl": ".", //diretorio base

    //outras opcoes necessarias
    "esModuleInterop": true, //se usar outro modulo de linguagem padrao, consegue integrar
    "skipLibCheck": true, //pula a verificação de tipo de arquivos se é js ou ts
    "forceConsistentCasingInFileNames": true, //obedece o nome de arquivo definido (por ex T maiusculo no nome)
    "moduleResolution": "node", //quem resolve os modulos é o node


  },
  //mais duas informações
  "include": [
    "src/**/*",
    "*.ts", //incluir arquivos typescript na raiz tambem
    "*.d.ts" //incluir arquivos de definicao de tipos
  ],
  "exclude":[
    "node_modules",
    "dist" //diretorios q eu nao quero que analisem
  ]
}

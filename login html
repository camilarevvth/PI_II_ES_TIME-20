  </form>

  <!-- se precisar cadastrar -->
  <form id="form-cadastro" style="display:none;">
    <input type="text" placeholder="Nome completo" required><br>
    <input type="email" placeholder="E-mail" required><br>
    <input type="tel" placeholder="Telefone celular" required><br>
    <input type="password" placeholder="Senha" required><br>
    <input type="submit" value="Cadastrar"><br><br>

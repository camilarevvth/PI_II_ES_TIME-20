
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Quadro de Notas Simplificado</title>
<style>
  .peso-input { width: 50px; margin: 0 5px; }
</style>
</head>
<body>

<h2>Cadastro de Alunos</h2>
<input type="text" id="matricula" placeholder="Matrícula">
<input type="text" id="nome" placeholder="Nome">
<button onclick="adicionarAluno()">Adicionar Aluno</button>

<h2>Cadastro de Componentes de Nota</h2>
<input type="text" id="compNome" placeholder="Nome">
<input type="text" id="compSigla" placeholder="Sigla (ex: P1)">
<button onclick="adicionarComponente()">Adicionar Componente</button>

<h2>Fórmula de Cálculo</h2>
<button onclick="usarMediaAritmetica()">Média Aritmética</button>
<button onclick="usarMediaPonderada()">Média Ponderada</button>

<div id="pesos-container" style="display:none; margin-top:10px;">
  <h3>Defina os pesos (%):</h3>
  <div id="inputs-pesos"></div>
  <button onclick="salvarPesos()">Salvar Pesos</button>
</div>

<h2>Quadro de Notas</h2>
<table id="tabela" border="1">
  <thead>
    <tr>
      <th>Matrícula</th>
      <th>Nome</th>
      <th>Nota Final</th>
    </tr>
  </thead>
  <tbody></tbody>
</table>

<script>
let alunos = {};      // dados dos alunos
let componentes = []; // componentes
let formula = "aritmetica"; // tipo de cálculo
let pesos = {};       // pesos para média ponderada

function adicionarAluno() {
  let mat = document.getElementById("matricula").value;
  let nome = document.getElementById("nome").value;
  if (!mat || !nome) { alert("Preencha matrícula e nome"); return; }

  alunos[mat] = { nome: nome, notas: {}, notaFinal: 0 };

  let tabela = document.getElementById("tabela").getElementsByTagName("tbody")[0];
  let linha = tabela.insertRow();
  linha.setAttribute("data-mat", mat);
  linha.insertCell().innerText = mat;
  linha.insertCell().innerText = nome;

  componentes.forEach(c => {
    let cel = linha.insertCell();
    cel.innerHTML = `<input type="number" data-sigla="${c.sigla}" min="0" max="10" onchange="atualizarNota(this)">`;
  });

  linha.insertCell().setAttribute("data-coluna", "NotaFinal");
  linha.cells[linha.cells.length-1].innerText = "0.00";

  document.getElementById("matricula").value = "";
  document.getElementById("nome").value = "";
}

function adicionarComponente() {
  let nome = document.getElementById("compNome").value;
  let sigla = document.getElementById("compSigla").value.toUpperCase();
  if (!nome || !sigla) { alert("Preencha todos os campos"); return; }
  if (componentes.some(c => c.sigla === sigla)) { alert("Componente já existe"); return; }

  componentes.push({ nome: nome, sigla: sigla });

  let tabela = document.getElementById("tabela");
  let header = tabela.tHead.rows[0];
  let th = document.createElement("th");
  th.innerText = sigla;
  header.insertBefore(th, header.cells[header.cells.length-1]);

  let tbody = tabela.tBodies[0];
  for (let i=0; i<tbody.rows.length; i++) {
    let cel = tbody.rows[i].insertCell(tbody.rows[i].cells.length-1);
    cel.innerHTML = `<input type="number" data-sigla="${sigla}" min="0" max="10" onchange="atualizarNota(this)">`;
  }

  document.getElementById("compNome").value = "";
  document.getElementById("compSigla").value = "";
}

function atualizarNota(input) {
  let mat = input.closest("tr").dataset.mat;
  let sigla = input.dataset.sigla;
  let val = parseFloat(input.value) || 0;
  if (val>10) val=10; if(val<0) val=0;
  input.value = val;

  alunos[mat].notas[sigla] = val;
  calcularNotaFinal(mat);
}

function calcularNotaFinal(mat) {
  let aluno = alunos[mat];
  let nf = 0;

  if (formula=="aritmetica") {
    let soma=0;
    componentes.forEach(c => soma += aluno.notas[c.sigla] || 0);
    nf = componentes.length ? (soma/componentes.length).toFixed(2) : "0.00";
  } else {
    let soma=0;
    componentes.forEach(c => {
      let peso = pesos[c.sigla]/100 || 0;
      soma += (aluno.notas[c.sigla] || 0) * peso;
    });
    nf = soma.toFixed(2);
  }

  aluno.notaFinal = nf;
  let cel = document.querySelector(`tr[data-mat="${mat}"] [data-coluna="NotaFinal"]`);
  cel.innerText = nf;
}

function usarMediaAritmetica() {
  formula = "aritmetica";
  document.getElementById("pesos-container").style.display = "none";
  Object.keys(alunos).forEach(m => calcularNotaFinal(m));
}

function usarMediaPonderada() {
  formula = "ponderada";
  let container = document.getElementById("pesos-container");
  let div = document.getElementById("inputs-pesos");
  div.innerHTML = "";
  componentes.forEach(c => {
    let inp = document.createElement("input");
    inp.type="number"; inp.min=0; inp.max=100;
    inp.value = pesos[c.sigla] || 0;
    inp.placeholder = c.sigla;
    inp.className = "peso-input";
    inp.dataset.sigla = c.sigla;
    div.appendChild(inp);
  });
  container.style.display = "block";
}

function salvarPesos() {
  let inputs = document.querySelectorAll("#inputs-pesos input");
  let total=0;
  inputs.forEach(i => { pesos[i.dataset.sigla] = parseFloat(i.value)||0; total += parseFloat(i.value)||0; });
  if (total != 100) { alert("Soma dos pesos deve ser 100%"); return; }
  Object.keys(alunos).forEach(m => calcularNotaFinal(m));
  alert("Pesos salvos!");
}
</script>

</body>
</html>
